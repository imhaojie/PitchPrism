# Local credentials belong only in ignored .env. Never in frontend JS.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Use az login locally and managed identity on Azure Container Apps.
AZURE_USE_ENTRA=1
# Optional API-key alternative; do not set this when using keyless identity.
AZURE_OPENAI_API_KEY=
PITCHPRISM_MAX_AI_CALLS_HOUR=12

# Optional service adapters. All are OFF; this file performs no cloud calls.
PITCHPRISM_ENABLE_CONTENT_SAFETY=0
AZURE_CONTENT_SAFETY_ENDPOINT=
# Optional key; omit for managed identity with Cognitive Services User access.
AZURE_CONTENT_SAFETY_KEY=
PITCHPRISM_ENABLE_BLOB_RECEIPTS=0
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_RECEIPT_CONTAINER=receipts
PITCHPRISM_ENABLE_TELEMETRY=0
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional alternative to direct Foundry key/Entra authentication.
# Leave the secret name empty to avoid Key Vault access at startup.
AZURE_KEY_VAULT_ENDPOINT=
AZURE_OPENAI_API_KEY_SECRET=
