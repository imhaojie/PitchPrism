# Local credentials belong only in ignored .env. Never in frontend JS.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Use az login locally and managed identity on Azure Container Apps.
AZURE_USE_ENTRA=1
# Optional API-key alternative; do not set this when using keyless identity.
AZURE_OPENAI_API_KEY=
PITCHPRISM_MAX_AI_CALLS_HOUR=12
